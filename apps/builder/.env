# To override environment variables, add a .env.development file in the same directory.
# For more details, visit: https://vitejs.dev/guide/env-and-mode#env-files
DATABASE_URL=postgresql://webstudio:pass@localhost:55432/webstudio
DIRECT_URL=postgresql://webstudio:pass@localhost:55432/webstudio
PGPORT=55432
POSTGRES_DB=webstudio
POSTGRES_USER=webstudio
POSTGRES_PASSWORD=pass

AUTH_SECRET=0000
PORT=5176

# GH_CLIENT_SECRET=
# GH_CLIENT_ID=
# selfhost: username/password sign-in (Better Auth).
# Create accounts with: npm run users -- add <username>
AUTH_USERNAME_LOGIN=true
# Local only; production needs its own random 32+ character secret.
BETTER_AUTH_SECRET=local-development-better-auth-secret-0000

# Optional max upload size in Mb
# MAX_UPLOAD_SIZE=10

# S3 envs
# S3_BUCKET=
# S3_REGION=
# S3_ACL="public-read"
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Asset CDN origin used by published builds, without a trailing slash.

# Publisher config
# PUBLISHER_HOST=wstd.io
# PUBLISHER_ENDPOINT=https://publisher.webstudio.is
# PUBLISHER_TOKEN=

# Username and password displayed in wstd domain settings
# STAGING_USERNAME=admin
# STAGING_PASSWORD=webstudio

# Base origin for accessing user-generated build (canvas / preview / etc)
# Should contain protocol and host (e.g. https://example.com)
# Will be detected automatically in development environments like localhost or preview deployment
# BUILD_ORIGIN=https://wstd.live

# If set to `true`, user-generated build will be available
# only at {project.domain} subdomain of {BUILD_ORIGIN}.
# This is used in production deployment for security reasons.
# BUILD_REQUIRE_SUBDOMAIN=

# Enable features behind a flag, * enables all.
FEATURE_FLAGS=*

# TRCP server url and API token. If empty local TRPC server is used
# TRPC_SERVER_URL=
TRPC_SERVER_API_TOKEN=e2e-service-token
