{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "packages/db/drizzle/**",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.jsonc",
    "docs/**",
    "packages/cli/templates/**",
    "fixtures/**/__generated__/**"
  ]
}
